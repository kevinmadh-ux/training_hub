# Copy these into Streamlit Cloud -> your app -> Settings -> Secrets
# (or save as .streamlit/secrets.toml when running on your own computer).
# Never put the real values in GitHub.

TRAINER_PASSWORD = "choose-a-long-password-only-you-know"
TIMEZONE = "America/Toronto"

[supabase]
url = "https://YOUR-PROJECT-ID.supabase.co"
service_key = "YOUR-SERVICE-ROLE-KEY"
